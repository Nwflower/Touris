{
  "name": "touris",
  "version": "0.1.0",
  "private": true,
  "description": "Touris 知途 · 记忆驱动的旅行规划前端",
  "scripts": {
    "test": "node tools/smoke-test.js",
    "check": "node tools/extract-seed.js --check",
    "seed": "node tools/extract-seed.js",
    "start": "node server/index.js",
    "llm:ping": "node tools/llm-ping.js",
    "serve": "node -e \"const h=require('http'),f=require('fs'),p=require('path');const root=p.join(__dirname,'app');const T={'.html':'text/html;charset=utf-8','.js':'text/javascript;charset=utf-8','.css':'text/css;charset=utf-8','.json':'application/json','.png':'image/png'};h.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/index.html';const fp=p.join(root,u);f.readFile(fp,(e,d)=>{if(e){s.writeHead(404);return s.end('404');}s.writeHead(200,{'Content-Type':T[p.extname(fp)]||'application/octet-stream','Cache-Control':'no-store'});s.end(d);});}).listen(8000,()=>console.log('http://localhost:8000'))\""
  },
  "engines": {
    "node": ">=18"
  }
}
